# 選擇要使用的 LLM 提供者: "vllm" 或 "gemini" 或 "ollama"   
LLM_PROVIDER=ollama

# ================================
# vLLM (OpenAI Compatible) API 設定
# ================================
VLLM_API_BASE=http://192.168.1.103:9000/v1
VLLM_MODEL=openai/gpt-oss-20b
VLLM_API_KEY=dummy-token  # vLLM 預設不需要真實的 key，但 OpenAI SDK 通常要求有值

# ================================
# Ollama (OpenAI Compatible) API 設定
# ================================
OLLAMA_API_BASE=http://192.168.1.103:11434/v1
# OLLAMA_MODEL=gemma4:e4b
OLLAMA_MODEL=gemma4:26b
# OLLAMA_MODEL=gemma4:31b
# OLLAMA_MODEL=qwen3.6

# ================================
# Gemini API 設定
# ================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ================================
# Embedding Configuration
# ================================
# ⚠ 必須與「索引建立時」用的模型相同。換了 provider/model 但沒 wipe+reindex,
#   查詢向量會落在不同向量空間 → 向量檢索靜默失效(維度相同時不會報錯)。
#   切換 embedding 一定要接著 wipe + reindex。
# 選擇向量庫的 Embedding 產生方式: "local" (預設), "ollama" 或 "gemini"
EMBEDDING_PROVIDER=local
# 指定的模型。若 provider=ollama 預設為 nomic-embed-text，provider=gemini 預設為 text-embedding-004
# 注意:nomic-embed-text 的 context 較短,CHUNK_SIZE 過大(如 5000)會被 400 拒絕。
# EMBEDDING_MODEL=nomic-embed-text

# 持久化 embedding cache (SQLite on <Database>/embedding_cache.sqlite)。
# 啟用時相同文字再次 embed 直接命中 SQLite，不會打到 local/Ollama/Gemini。
# 跨 provider 切換、wipe + reindex 都能省下 embedding 成本。
EMBEDDING_CACHE_ENABLED=true

# ================================
# Reranker Configuration（強烈建議開啟）
# ================================
# Cross-encoder 對 (query, chunk) 重新打分。它是「多語」的——能把中文查詢正確
# 排到英文/德文文件，是 cross-lingual 檢索的主要槓桿。實測開啟後 golden-query
# bench 0.867 → 0.933。
# 開啟需先安裝（會拉 sentence-transformers + torch，首次下載模型 ~568MB）：
#   venv/bin/pip install -r requirements-reranker.txt
# ⚠ 未安裝此套件時，即使設 true 也會「靜默退回停用」（只留一行 log）。
RERANKER_ENABLED=true
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RERANKER_MULTIPLIER=5

# ── 跨語言查詢翻譯擴展（次要 recall hedge，預設關）──
# reranker 已是主槓桿；此項只在「外語文件根本沒進候選池」的邊角才有用。
# 開啟會對每次查詢多打一次 LLM 翻譯。
# CROSS_LINGUAL_ENABLED=false
# CROSS_LINGUAL_TARGET_LANGS=en,zh

# ================================
# Hybrid Retrieval (BM25 + RRF)
# ================================
# BM25 詞彙索引 + 向量結果，用 Reciprocal Rank Fusion 合併。
# 對專有名詞、code identifier、書名等「精確 token」查詢效果顯著。
# 索引在第一次 hybrid query 時 lazy build (sub-second for 1000s of chunks)，
# 之後 add/delete 自動 mark dirty。
HYBRID_RETRIEVAL_ENABLED=true
# BM25_MULTIPLIER=3

# ================================
# Facet Index & Backfill
# ================================
# 啟用 Facet 索引 (將摘要轉為檢索指標以對齊語意)
FACET_INDEX_ENABLED=true
FACET_MAX_PER_DOC=8

# 系統閒置時自動回填舊文件的 Facet (低優先權、防餓死)
FACET_BACKFILL_ENABLED=true
FACET_BACKFILL_GRACE_SECONDS=180
FACET_BACKFILL_STEP_GAP_SECONDS=30
FACET_BACKFILL_DAILY_BUDGET=1000
FACET_BACKFILL_MAX_ATTEMPTS=3
FACET_BACKFILL_MIN_BYTES=400

# ================================
# Cortex Memory (Phase 1)
# ================================
# Enable computing quality signals for generated insights
INSIGHT_SIGNALS_ENABLED=true
# Enable LLM-based refute check for insights (requires INSIGHT_SIGNALS_ENABLED=true)
INSIGHT_REFUTE_ENABLED=true

# ================================
# Cortex Memory (Phase 2 - 夜間鞏固)
# ================================
# 將通過品質訊號閘門的 insights 蒸餾成原子主張，鞏固進 Cortex/ 頁面
CORTEX_CONSOLIDATION_ENABLED=true
# 每晚最多處理幾份 insight（claim 抽取，各 1 次 LLM call）
CORTEX_MAX_INSIGHTS_PER_NIGHT=10
# 同一內容連續失敗幾次後隔離；檔案內容改變會自動解除隔離
CORTEX_CONSOLIDATION_MAX_ATTEMPTS=3
# 隔離多久後 half-open 探測一次，讓供應商 outage 恢復後自癒
CORTEX_CONSOLIDATION_QUARANTINE_HOURS=24
# 每晚蘊涵裁決上限（快取命中不計）
CORTEX_MAX_ADJUDICATIONS_PER_NIGHT=20
# 鄰居搜尋：相似度門檻與每個主張最多裁決的鄰居數
CORTEX_NEIGHBOR_SIM_THRESHOLD=0.80
CORTEX_NEIGHBOR_TOP_K=3
# 每頁 Nuances 變體區容量上限
CORTEX_MAX_VARIANTS=5

# 夜間 insight 改為 doc-anchored（興趣加權 + ε 探索選種子）；全庫洞察降為每週
INSIGHT_SEED_EPSILON=0.2
INSIGHT_SEED_TARGETS=2

# Cortex Phase 3：雙強度衰減（S 只增、R 現算）、遲滯狀態機、revival 自校準
CORTEX_DECAY_ENABLED=true
CORTEX_DECAY_BASE_DAYS=21
CORTEX_DECAY_GROWTH=1.8
CORTEX_REVALIDATIONS_PER_NIGHT=3

# Cortex Phase 4：主張帳本（保守 falsified + un-merge 裁決收緊回饋）
CORTEX_LEDGER_ENABLED=true
CORTEX_FALSIFY_PER_NIGHT=2
CORTEX_FALSIFY_SAMPLES=3

# Cortex 記憶 · F1 grounded insight（安全閘,非口味）
# 讓累積的 Cortex 信念以「請挑戰、不要附和」的辯證 prior 參與洞察生成。五道反
# 同溫層防禦齊備後才開,需重啟 daemon。開啟後跑幾晚 → echo_canary 無 alarm → 維持。
# 只 ground CORTEX_GROUND_FRACTION 比例的 seed,其餘留 cold 當金絲雀對照組。
CORTEX_GROUNDED_INSIGHT_ENABLED=false

# Backlog batch-2：critique verdict 為 revise/reject 時的 synthesis 重生次數（0 = 關閉）
SYNTHESIS_CRITIQUE_MAX_RETRIES=1

# Lens 報告引文錨定比例低於此值 → quality_verdict=revise（翻譯/改寫引文會合法落空，故預設寬鬆）
LENS_QUOTE_MIN_GROUNDED_RATIO=0.8
